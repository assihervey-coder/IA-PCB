!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# ---- YahriaCad : pipeline R&D Python (ai-engine/) ----
# Données brutes / transformées (hors .gitkeep)
ai-engine/data/raw/*
!ai-engine/data/raw/.gitkeep
ai-engine/data/processed/*
!ai-engine/data/processed/.gitkeep
ai-engine/data/augmentations/*
!ai-engine/data/augmentations/.gitkeep
# Checkpoints de modèles entraînés (non requis : inférence = moteur TS)
*.pt
# Caches et environnements virtuels Python
ai-engine/**/__pycache__/
venv/
.venv/
ai-engine/training/**/logs/
scripts/.bin/
download/*.zip
.cache/
yahriacad-data/

# --- Artefacts outils locaux (IA) ---
tool-results/
tmp-rt/*.tgz

# --- Toolchain local (survit au redémarrage sandbox) ---
.tools/

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yahriacad.pro/schemas/project.schema.json",
  "title": "YahriaCad Project",
  "description": "Métadonnées d'un projet PCB YahriaCad (persisté en SQL, exposé par l'API REST)",
  "type": "object",
  "required": ["name", "layer_count"],
  "properties": {
    "id": { "type": "string", "format": "uuid", "readOnly": true },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Nom du projet (non vide)"
    },
    "description": { "type": "string", "maxLength": 2000, "default": "" },
    "layer_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 34,
      "default": 2,
      "description": "Nombre de couches cuivre (1 à 34)"
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived"],
      "default": "active"
    },
    "created_at": { "type": "string", "format": "date-time", "readOnly": true },
    "updated_at": { "type": "string", "format": "date-time", "readOnly": true }
  },
  "additionalProperties": false
}

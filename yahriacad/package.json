{
  "name": "yahriacad",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo YahriaCad : logiciel de CAO PCB piloté par l'IA (backend Go, moteur IA Python/gRPC, frontend Next.js)",
  "license": "AGPL-3.0",
  "scripts": {
    "backend:run": "go run ./backend/cmd/yahriacad-server",
    "backend:build": "go build -o bin/yahriacad-server ./backend/cmd/yahriacad-server",
    "backend:test": "go test ./...",
    "ai:run": "python3 ai-engine/cmd/ai-server/main.py",
    "ai:test": "cd ai-engine && python3 -m pytest -q",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "e2e": "npm --prefix tests/e2e run test"
  },
  "engines": {
    "node": ">=18.17"
  }
}

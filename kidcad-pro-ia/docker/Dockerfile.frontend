# ==============================================================
# KidCAD-Pro-IA — image Docker du frontend Next.js
#
# Construction (depuis la racine du monorepo) :
#   docker build -f docker/Dockerfile.frontend -t kidcad-frontend .
#
# Le rendu est SSR/CSR Next.js (pas d'export statique) : l'image d'exécution
# est donc node:20-alpine et lance `npm start` (next start). Pour exposer le
# cluster derrière un reverse-proxy frontal (TLS, gzip, cache statique,
# WebSocket), voir configs/production/nginx.conf : il est monté dans un
# conteneur optionnel `nginx` qui proxifie /api/ et /ws/ vers le backend
# et / vers ce conteneur frontend (port 3000).
# ==============================================================

# ---- Étape 1 : dépendances ----------------------------------------------
FROM node:20-alpine AS deps

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

# ---- Étape 2 : build ------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./

# NEXT_PUBLIC_* doit être connu au moment du build.
ARG NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN npm run build

# ---- Étape 3 : image d'exécution ----------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# node_modules + artefacts .next inclus (SSR requis, pas de standalone).
COPY --from=builder /app /app

EXPOSE 3000

CMD ["npm", "start"]

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kidcad.pro/schemas/constraint-set.schema.json",
  "title": "KidCAD Constraint Set",
  "description": "Ensemble de règles de conception (DRC) associé à un projet",
  "type": "object",
  "required": ["name", "rules"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "rule_type": {
      "type": "string",
      "enum": [
        "min_clearance",
        "min_track_width",
        "max_track_width",
        "min_via_diameter",
        "min_drill",
        "min_annular_ring",
        "edge_clearance"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["error", "warning"]
    },
    "rule": {
      "type": "object",
      "required": ["id", "type", "value_mm"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "type": { "$ref": "#/definitions/rule_type" },
        "scope": {
          "type": "object",
          "properties": {
            "net_class": { "type": "string", "default": "*" },
            "layer": { "type": "integer", "minimum": -1, "default": -1 }
          }
        },
        "value_mm": { "type": "number", "exclusiveMinimum": 0 },
        "severity": { "$ref": "#/definitions/severity", "default": "error" },
        "enabled": { "type": "boolean", "default": true }
      }
    }
  }
}
